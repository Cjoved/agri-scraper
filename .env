UNWANTED_TEXTS=Data not available, Latest update:, Source:, Contact:, Chief Statistical Specialist,Philippine Statistics Authority (PSA), Price Statistics Division (PSD), Units:,peso per kilogram, Internal reference code:, Notes in Computation, Revised, M4AWA01,GLEN G. POLO, Cereals: Wholesale Selling Prices of Agricultural Commodities

# Set to true to resume from checkpoint (skip URLs already completed). Set to false to restart from first URL.
RESUME_CHECKPOINT=false
# Huwag i-delete ang PDF pagkatapos i-process para may backup kung mali ang process.
PHILRICE_DELETE_PDF_AFTER_CLEAN=false

# Main.py: isa lang dapat true per run. PHILRICE / PHILRICE_NEWS / PINOYRICE / OPENSTAT
OPENSTAT=false
PHILRICE=false
PHILRICE_NEWS=false
PINOYRICE=true

# PhilRice: true = PDF mula lang sa downloads + knowledge-products + rd-highlights (hindi buong site)
PHILRICE_DOWNLOADS_ONLY=true
PHILRICE_DELAY_PAGE=15
PHILRICE_DELAY_PDF=10

# PhilRice News (scraper_philrice_news.py + processing_philrice_news.py)
# Keep .txt as backup (like PDFs) - hindi tinatanggal pagkatapos i-process.
PHILRICE_NEWS_DELETE_TXT_AFTER_PROCESS=false
# Scraper: delay between pages/articles (seconds). Default 3.
PHILRICE_NEWS_DELAY=3
# Processing: chunking. 0 = one record per article; 4000 ≈ 1024 tokens for CPT.
PHILRICE_NEWS_MIN_CHUNK_CHARS=100
PHILRICE_NEWS_MAX_CHUNK_CHARS=0

# PinoyRice processing / scraping
PINOYRICE_MIN_CHUNK_CHARS=100
PINOYRICE_MAX_CHUNK_CHARS=0
HEADLESS=false
# PINOYRICE_UNWANTED_TEXTS=HOME,RICE PRODUCTION,RICE VARIETIES,DOWNLOADS,SEED GROWERS,OFFLINE,Search for:,Menu -HOME,Are you satisfied with PINOYRICE KNOWLEDGE BANK?,uQuoted.com